# =============================================================================
# AI Aggregator Platform — environment variables
# Copy to `.env` and fill in real values for production.
# =============================================================================

# --- Core ----------------------------------------------------------------
NODE_ENV=development
APP_NAME="AI Aggregator"
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PUBLIC_API_URL=http://localhost:4000

# --- Database (Postgres) ------------------------------------------------
POSTGRES_USER=ai_platform
POSTGRES_PASSWORD=ai_platform_dev
POSTGRES_DB=ai_platform
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://ai_platform:ai_platform_dev@localhost:5432/ai_platform?schema=public

# --- Redis ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_TLS=false

# --- Auth ----------------------------------------------------------------
JWT_ACCESS_SECRET=change-me-access-secret-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-secret-32chars-min
JWT_ACCESS_TTL=900            # 15 minutes
JWT_REFRESH_TTL=2592000       # 30 days
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false           # true in production
SESSION_COOKIE_NAME=ai_session
CSRF_SECRET=change-me-csrf-secret

# --- OAuth providers -----------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=

# --- Notifications -------------------------------------------------------
# Either Resend (preferred — no SMTP server) OR SMTP, not both. Leaving all
# blank in dev makes the API just log the email content.
RESEND_API_KEY=
# Used by both Resend and SMTP. SMTP_FROM kept for backward-compat.
MAIL_FROM="AI Aggregator <noreply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AI Aggregator <noreply@example.com>"
# Threshold ($USD) below which users get a low-balance alert (default $5).
LOW_BALANCE_THRESHOLD_USD=5

# --- AI providers (server-side only — NEVER expose to client) ------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
MISTRAL_API_KEY=
XAI_API_KEY=
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- Anti-abuse / fraud --------------------------------------------------
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FINGERPRINTJS_PUBLIC_KEY=
IPQUALITYSCORE_API_KEY=
MAXMIND_LICENSE_KEY=
ABUSE_RISK_THRESHOLD=70

# --- Billing -------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
YOOMONEY_SHOP_ID=
YOOMONEY_SECRET_KEY=
YOOMONEY_WEBHOOK_SECRET=
SBP_MERCHANT_ID=
SBP_SECRET_KEY=
TELEGRAM_STARS_BOT_TOKEN=
CRYPTO_PROCESSOR=cryptocloud
CRYPTOCLOUD_API_KEY=
CRYPTOCLOUD_SHOP_ID=
CRYPTOCLOUD_WEBHOOK_SECRET=

# --- Media providers (TTS, STT, image, video) ---------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_DEFAULT_VOICE_ID=
# Midjourney has no official API — wire any 3rd-party provider (GoAPI, ImagineAPI, useapi.net, etc.)
MIDJOURNEY_API_BASE_URL=
MIDJOURNEY_API_KEY=
MIDJOURNEY_WEBHOOK_URL=
MIDJOURNEY_WEBHOOK_SECRET=
STABILITY_API_KEY=
RUNWAY_API_KEY=
RUNWAY_API_BASE_URL=
KLING_API_KEY=
KLING_API_BASE_URL=

# --- Cost protection (per-user defaults; admin can override) -------------
DEFAULT_DAILY_USD_LIMIT=20
DEFAULT_MONTHLY_USD_LIMIT=200
DEFAULT_PER_REQUEST_MAX_TOKENS=8000
HARD_BALANCE_CUTOFF_USD=0
SOFT_BALANCE_ALERT_USD=1
PROFITABILITY_MARGIN_PERCENT=20

# --- CDN / proxy ---------------------------------------------------------
CLOUDFLARE_TUNNEL_TOKEN=
TRUSTED_PROXIES=127.0.0.1,::1

# --- Frontend (Next.js — only NEXT_PUBLIC_* exposed to client) -----------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
NEXT_PUBLIC_FINGERPRINTJS_KEY=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA_ID=
