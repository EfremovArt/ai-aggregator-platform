{
  "name": "ai-aggregator-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Production-ready AI aggregator platform (OpenRouter / GPTunnel-style) — Next.js 15 + NestJS + Prisma + PostgreSQL + Redis",
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.15.1",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./apps/*\" build",
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "lint": "pnpm -r --parallel lint",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "db:generate": "pnpm --filter @ai-platform/database generate",
    "db:migrate": "pnpm --filter @ai-platform/database migrate:dev",
    "db:deploy": "pnpm --filter @ai-platform/database migrate:deploy",
    "db:seed": "pnpm --filter @ai-platform/database seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
